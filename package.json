{
  "name": "tirgul-project",
  "version": "1.0.0",
  "private": true,
  "description": "Login and register forms with Node, Express and Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --watch",
    "start": "npm run build:css && node server.js",
    "dev": "npm run watch:css & node --watch server.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
